{
	"name": "pit-wall-replay",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently -n server,client \"npm run dev -w packages/server\" \"npm run dev -w packages/client\"",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@types/node": "^22.20.4",
		"concurrently": "^10.0.5",
		"typescript": "~6.0.2"
	}
}
